# ── 依赖 ──────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── 构建产物 ──────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── 本地环境与密钥（绝不入库）──────────────────────────
.env
.env.local
.env.*.local
secrets/
*.pem
*.key

# ── 运行时数据 ────────────────────────────────────────
# 模型在现场造的 Python 工具、人审通过的对接脚本，都是运行时产物
harness/toolbox/*
harness/adapters/*
!harness/toolbox/.gitkeep
!harness/adapters/.gitkeep

# 探针的本地数据
apps/probe/data/*.json
apps/probe/data/*.log

# ── 编辑器与系统 ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 日志与临时文件 ────────────────────────────────────
*.log
*.tmp
