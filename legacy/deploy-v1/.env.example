# NetOps 一体机环境变量模板
# 规则：本文件里只允许出现「引用名」，绝不允许出现明文密码/密钥。
# 明文由本地 Vault 或 DSH credentials（$DSH_HOME/.credentials.yaml / 进程环境）提供。

# ── 站点与探针 ────────────────────────────────────────────────
SITE_ID=home-01
PROBE_ID=probe-01
# ★ 必须显式指定：否则广播/组播可能被 Docker/VirtualBox/Wi-Fi Direct 等
#   度量更低的虚拟网卡抢走，导致 SSDP/ONVIF/mDNS 发现静默失败。
PROBE_EGRESS_IFACE=eth0
PROBE_INTERVAL_S=300

# ── 凭据引用名（值是「引用名」，不是密码）──────────────────────
NETOPS_VAULT_KEY_REF=NETOPS_VAULT_MASTER_KEY
DSH_LLM_KEY_REF=NETOPS_LLM_KEY
# 客户 GitHub 私有仓（一客户一仓）
CUSTOMER_GIT_REMOTE=git@github.com:your-org/netops-customer-home-01.git
GIT_DEPLOY_KEY_REF=NETOPS_GIT_DEPLOY_KEY

# ── 需要写在 files 里的密码（docker secrets，非 env）─────────
# 见 deploy/secrets/pg_password —— 不要写进本文件
MQTT_DASHBOARD_PASSWORD=change-me-and-move-to-secret

# ── 报告与区域 ────────────────────────────────────────────────
NETOPS_TZ=Asia/Shanghai
REPORT_DAILY_CRON=0 7 * * *
REPORT_WEEKLY_CRON=0 7 * * 1

# ── 模型路由（成本控制：日常汇总用便宜模型，根因分析用强模型）──
NETOPS_MODEL_SUMMARY=deepseek-chat
NETOPS_MODEL_RCA=deepseek-reasoner
