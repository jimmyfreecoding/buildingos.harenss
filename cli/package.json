{
  "name": "@buildingos/cli",
  "version": "0.1.0",
  "description": "BuildingOS CLI — tenant scaffold (init), validation (normalizer), engine-view compilation (adapters), conformance. Self-contained bundle for global install.",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "buildingos": "dist/cli.bundle.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && pnpm bundle",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node dist/e2e.js"
  },
  "devDependencies": {
    "@buildingos/adapter-codex": "workspace:*",
    "@buildingos/adapter-dsh": "workspace:*",
    "@buildingos/bootstrap": "workspace:*",
    "@buildingos/conformance": "workspace:*",
    "@buildingos/normalizer": "workspace:*",
    "@buildingos/web": "workspace:*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
