# NetOps 环境变量 —— 只放引用名，绝不放明文
# cp .env.example .env

# ── 站点与网络 ──────────────────────────────────────────────
SITE_ID=home-01
PROBE_ID=probe-01
# ★ 必须显式指定。否则广播/组播会被 VirtualBox / Wi-Fi Direct 等低度量虚拟网卡抢走，
#   表现为 SSDP/ONVIF/mDNS 发现静默 0 响应。
NETOPS_EGRESS_IFACE=eth0
PROBE_INTERVAL_S=300
NETOPS_TZ=Asia/Shanghai

# ── 凭据引用名（值是引用名，不是密码）──────────────────────
NETOPS_PG_DSN_REF=NETOPS_PG_DSN
DSH_LLM_KEY_REF=NETOPS_LLM_KEY

# ── 客户 Git 私有仓（一客户一仓）────────────────────────────
CUSTOMER_GIT_REMOTE=git@github.com:your-org/netops-customer-home-01.git

# ── docker secrets 用（不要写进本文件）──────────────────────
# deploy/secrets/pg_password
MQTT_DASHBOARD_PASSWORD=change-me-and-move-to-secret

# ── 报告 ────────────────────────────────────────────────────
REPORT_DAILY_CRON=0 7 * * *
REPORT_WEEKLY_CRON=0 7 * * 1
